# === DJANGO ===
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:5173

# === DATABASE ===
DATABASE_URL=postgresql://devmind:devmind_secret@postgres:5432/devmind

# === REDIS / CELERY ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === PUBLIC URLS ===
# Where the browser app runs. Read into Django settings but currently unused;
# the OAuth redirect is the callback URL configured on the GitHub OAuth App.
FRONTEND_URL=http://localhost:5173
# Public URL GitHub sends webhooks to (an ngrok URL in local development)
DEVMIND_PUBLIC_URL=http://localhost:8000

# === GITHUB OAuth ===
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-hmac-secret

# === LLM PROVIDERS (FastAPI) ===
# Server-wide failover chain, tried in this order; providers without a key are
# skipped. Users' own BYOK keys (Settings page) are tried before these.
# Google AI Studio key: Gemini reviews + text-embedding-004 embeddings
GOOGLE_AI_API_KEY=your-google-ai-studio-key
# Groq key (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GitHub token with access to GitHub Models (gpt-4o-mini)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
LLM_FAILOVER_ENABLED=True
# Sampling temperature for review analyzer calls (default 0.1)
REVIEW_TEMPERATURE=0.1

# === FASTAPI SERVICE ===
FASTAPI_INTERNAL_SECRET=internal-service-token-here
FASTAPI_BASE_URL=http://fastapi:8001
FASTAPI_TIMEOUT_SECONDS=60
FASTAPI_DATABASE_URL=postgresql+asyncpg://devmind:devmind_secret@postgres:5432/devmind
# FastAPI -> Django internal calls (BYOK key lookup)
DJANGO_BASE_URL=http://django:8000

# === SENTRY ===
# Empty disables Sentry. Example: SENTRY_DSN_DJANGO=https://<key>@o0.ingest.sentry.io/<project>
SENTRY_DSN_DJANGO=
SENTRY_DSN_FASTAPI=
SENTRY_ENVIRONMENT=development

# === JWT ===
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === AWS (for production) ===
AWS_REGION=us-east-1
AWS_S3_BUCKET=devmind-media-prod
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === PROMETHEUS / GRAFANA ===
GRAFANA_ADMIN_PASSWORD=admin_secret_here

# === RATE LIMITING ===
REVIEW_RATE_LIMIT_PER_HOUR=20
API_GLOBAL_RATE_LIMIT=1000
